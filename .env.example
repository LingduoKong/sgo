# Any OpenAI-compatible LLM API
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=openai/gpt-4o-mini

# Cheaper model for setup calls (infer-spec, suggest-segments, cohort filters).
# Defaults to Qwen/Qwen2.5-7B-Instruct if unset — set it explicitly to a model
# your provider actually serves, or those calls fail with "invalid model ID".
LLM_FAST_MODEL=openai/gpt-4o-mini

# NOTE: model names above use OpenRouter's "provider/model" form. Pointing
# LLM_BASE_URL at a provider's own API (e.g. https://api.openai.com/v1) means
# dropping the prefix — "gpt-4o-mini", not "openai/gpt-4o-mini".

# For reasoning models (gpt-5-mini, o3, etc.), the scripts use max_tokens=16384
# to accommodate reasoning tokens. Adjust if needed.

# Private access is always required. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_DB_PATH=data/private/auth.sqlite3
# Local development only; production Compose derives HTTPS origin from SGO_DOMAIN.
APP_ORIGIN=http://127.0.0.1:8000
SGO_DOMAIN=sgo.example.com
AWS_REGION=us-west-2
SES_FROM_EMAIL=login@example.com
# Supply a least-privilege SES sender identity via the standard AWS credential chain.
# Never commit real AWS credentials. Lightsail does not use EC2 instance profiles.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional reply mailbox, separate from the SES-verified sender.
SES_REPLY_TO_EMAIL=
